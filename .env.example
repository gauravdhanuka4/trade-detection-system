# =============================================================================
# Trade Detection System Configuration
# =============================================================================

# ... (Server, Database, Redis, JWT, Auth sections remain the same) ...

# =============================================================================
# Queue Configuration
# =============================================================================
QUEUE_PROVIDER=redis
QUEUE_WORKERS=5

# =============================================================================
# Application Configuration
# =============================================================================
APP_ENVIRONMENT=development
APP_LOG_LEVEL=info
APP_DEBUG=false

# =============================================================================
# Worker Configuration 
# =============================================================================
# Settings for the background trade processor
WORKER_CONSUMER_GROUP=trade-processors
WORKER_CONSUMER_NAME=worker-1
WORKER_BATCH_SIZE=10
WORKER_PROCESSING_TIMEOUT=5
WORKER_MAX_RETRIES=3
WORKER_STREAM_NAME=trades:stream
WORKER_POLL_INTERVAL=1000
WORKER_DB_SYNC_INTERVAL_MINUTES=5
WORKER_DB_SYNC_ENABLED=true

# =============================================================================
# Detection Rules Configuration 
# =============================================================================
# 1. Wash Trading (Buying and selling same asset rapidly)
RULES_WASH_TRADE_ENABLED=true
RULES_WASH_TRADE_TIME_WINDOW_SECS=5
RULES_WASH_TRADE_PRICE_TOLERANCE=0.001

# 2. Velocity (Too many trades in short time)
RULES_VELOCITY_ENABLED=true
RULES_VELOCITY_TIME_WINDOW_SECS=10
RULES_VELOCITY_THRESHOLD=10

# 3. Anomaly (Unusual size or price deviation)
RULES_ANOMALY_ENABLED=true
RULES_ANOMALY_SIZE_MULTIPLIER=10.0
RULES_ANOMALY_PRICE_DEVIATION=0.25